{
  "name": "@alice-io/caterpillar",
  "version": "1.0.11",
  "description": "Security scanner for AI agent skills",
  "main": "core/src/library.ts",
  "bin": {
    "caterpillar": "./dist/cli.js"
  },
  "scripts": {
    "build": "esbuild core/src/index.ts --bundle --platform=node --target=node18 --outfile=dist/cli.js --format=cjs --banner:js=\"#!/usr/bin/env node\"",
    "dev": "npx tsx core/src/index.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "security",
    "ai",
    "claude",
    "skills",
    "scanner",
    "malware",
    "detection"
  ],
  "author": "Alice Security",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alice-dot-io/caterpillar"
  },
  "homepage": "https://caterpillar.alice.io/",
  "dependencies": {
    "commander": "^12.0.0",
    "openai": "^4.0.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.27.3",
    "tsx": "^4.0.0",
    "typescript": "^5.3.3",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
